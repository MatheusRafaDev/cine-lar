# Configuração do MatheusFlix Backend (torrent-service)
PORT=8085
HOST=0.0.0.0
SAVE_PATH=D:\Filmes
JELLYFIN_URL=http://localhost:8096
JELLYFIN_USER=usuario
JELLYFIN_PW=sua_senha_jellyfin_aqui
TMDB_API_KEY=sua_chave_tmdb_aqui
# Token opcional para proteger rotas de escrita/exclusão (enviado no header X-Api-Token)
# MUTATION_API_TOKEN=seu_token_secreto_aqui

# Caminhos opcionais para executáveis (caso não estejam no PATH)
# FFMPEG_PATH=C:\Program Files\Jellyfin\Server\ffmpeg.exe
# FFPROBE_PATH=C:\Program Files\Jellyfin\Server\ffprobe.exe

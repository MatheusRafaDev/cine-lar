# Configuração do Cine Lar Backend (torrent-service)
PORT=8085
HOST=0.0.0.0
SAVE_PATH=D:\Filmes
TMDB_API_KEY=sua_chave_tmdb_aqui
# Obrigatório para chamadas POST/PUT/PATCH/DELETE em /api (header X-Api-Token).
# Gere um valor aleatório exclusivo e configure o mesmo token nas configurações da TV.
MUTATION_API_TOKEN=

# Origens CORS adicionais exatas, separadas por virgula. Vite: http://localhost:3000
# Para o pacote nativo da TV, adicione null somente se a TV enviar Origin: null.
ALLOWED_ORIGINS=

# Caminhos opcionais para executáveis (caso não estejam no PATH)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

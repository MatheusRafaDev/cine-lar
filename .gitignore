# =======================================================
# Cine Lar - Git Ignore
# =======================================================

# Dependências (Node.js)
node_modules/
*/node_modules/

# Builds e pacotes compilados (gerados automaticamente pelo build-tv.ps1 e vite build)
dist/
react-tv-app/dist/
tizen-package/
*.wgt
.tizen-rds/

# Logs e relatórios de debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente e credenciais locais
.env
*.env
.env.local
.env.*.local
!.env.example

# Banco de dados local SQLite e estado transitório de downloads
*.db
*.db-journal
*.db-wal
*.db-shm
downloads.json
torrent-service/downloads.json

# Arquivos de sistema e temporários
.DS_Store
Thumbs.db
desktop.ini
scratch/
.tmp/
*.tmp

# Diretórios legados removidos
jellyfin-web/
jellyfin-web_git_backup/
